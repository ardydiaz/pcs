    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const facultyCourseMap = new Map();
            @json($facultyCourseOptions).forEach(option => {
                facultyCourseMap.set(option.id, option);
            });

            const courseDropdown = document.querySelector('#scheduleCreateModal [data-course-dropdown]');
            if (courseDropdown) {
                const hiddenInput = courseDropdown.querySelector('input[name="faculty_course_id"]');
                const detailsDisplay = document.getElementById('courseDetailsDisplay');
                const detailFaculty = document.getElementById('detailFaculty');
                const detailSection = document.getElementById('detailSection');
                const detailAcademicYear = document.getElementById('detailAcademicYear');
                const detailSemester = document.getElementById('detailSemester');

                const updateDetails = () => {
                    const courseId = hiddenInput.value;
                    if (!courseId || !facultyCourseMap.has(parseInt(courseId))) {
                        detailsDisplay.style.display = 'none';
                        return;
                    }

                    const option = facultyCourseMap.get(parseInt(courseId));
                    detailFaculty.textContent = option.faculty || '—';
                    detailSection.textContent = option.section || '—';
                    detailAcademicYear.textContent = option.academic_year_display || '—';
                    detailSemester.textContent = option.semester || '—';
                    detailsDisplay.style.display = 'block';
                };

                hiddenInput.addEventListener('change', updateDetails);
                courseDropdown.parentElement.addEventListener('shown.bs.dropdown', () => {
                    setTimeout(updateDetails, 50);
                });
            }
        });
    </script>
    @endif
    @endif

